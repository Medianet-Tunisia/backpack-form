{
    "name": "medianet-dev/backpack-form",
    "description": "add field for create form in your backpackforlaravel admin",
    "license": "MIT",
    "authors": [
        {
            "name": "Medianet",
            "email": "contact@medianet.com.tn",
            "homepage": "https://medianet.tn"
        }
    ],
    "homepage": "https://github.com/Medianet-Tunisia/backpack-form",
    "keywords": [
        "Laravel",
        "Backpack",
        "Backpack for Laravel",
        "Backpack Addon",
        "BackpackForm"
    ],
    "require": {
        "illuminate/support": "^7.0|^8.0|^9.0|^10.0|^11.0|^12.0",
        "backpack/crud": "^4.1.0|^5.0|^6.0|^7.0",
        "spatie/laravel-activitylog": "^4.10"
    },
    "require-dev": {
        "phpunit/phpunit": "~9.0|^11.0|^12.0",
        "orchestra/testbench": "~5|~6|~7|~8|~9|~10|~11|~12"
    },
    "autoload": {
        "psr-4": {
            "MedianetDev\\BackpackForm\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MedianetDev\\BackpackForm\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit --testdox"
    },
    "extra": {
        "laravel": {
            "providers": [
                "MedianetDev\\BackpackForm\\AddonServiceProvider"
            ]
        }
    }
}